{
  "version": 1,
  "name": "api",
  "domain": "api.example.com",
  "runtime": "python",
  "port": 8000,
  "start": ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"],
  "test": ["python", "-m", "unittest", "discover", "-s", "tests"],
  "health": {"path": "/health", "contains": "ok", "attempts": 60, "interval": 2},
  "environment": {"APP_ENV": "production"},
  "secrets": {"APP_SECRET": "api-secret"},
  "database": {"name": "api", "user": "api", "password_secret": "api-database", "backup_hours": 24, "retain": 14},
  "redis": true,
  "volumes": {"uploads": "/data/uploads"},
  "resources": {"memory_mb": 512, "cpus": 1, "min_disk_mb": 2048},
  "monitor": {"interval": 60, "restart": true, "cooldown": 900, "max_repairs": 2}
}
